# Install as /etc/medradar/pipeline.env, owner root:medradar, mode 0640.
# Never commit the real key.
#
# Option A: keep the key in this root-readable file:
# OPENFDA_API_KEY=replace-with-your-key
#
# Option B: point at a separate file owned by medradar with mode 0600:
# MEDRADAR_OPENFDA_KEY_FILE=/etc/medradar/openfda.key

MEDRADAR_OPENFDA_RPM=60
MEDRADAR_OPENFDA_TIMEOUT=90
MEDRADAR_OPENFDA_RETRIES=4
MEDRADAR_PIPELINE_MIN_FREE_BYTES=2147483648
MEDRADAR_PIPELINE_MAX_DROP_RATIO=0.02
MEDRADAR_PIPELINE_REMOVAL_CONFIRMATIONS=2
MEDRADAR_PIPELINE_RECHECK_CAP=50
MEDRADAR_PIPELINE_MAX_PRODUCT_SOURCES_PER_RUN=1
MEDRADAR_PIPELINE_FULL_RECONCILE_HOURS=168
MEDRADAR_PIPELINE_FULL_RECONCILE_MAX_SOURCES=1
MEDRADAR_PIPELINE_DAILY_LIMIT=900

# DATA-003 host resource guard. The pipeline refuses to start a memory-heavy reconciliation
# when the shared host lacks headroom, and records DEFERRED_RESOURCE_PRESSURE instead.
# Calibration and rationale: docs/data/data_003/RESOURCE_GUARDS.md.
MEDRADAR_PIPELINE_RESOURCE_GUARD=1
MEDRADAR_PIPELINE_MIN_AVAILABLE_MB=1200
MEDRADAR_PIPELINE_MIN_SWAP_FREE_MB=384
MEDRADAR_PIPELINE_MAX_PSI_SOME=8.0
MEDRADAR_PIPELINE_MIN_DISK_FREE_MB=2048
