{"header":{"numFound":1,"maxScore":1.0,"queryTime":10,"page":1,"pageSize":5},"results":[{"authors":[{"fullName":"Merle S. Losch","name":"Merle S.","surname":"Losch","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-9094-1266"},"provenance":null}},{"fullName":"Famke Kardux","name":"Famke","surname":"Kardux","rank":2,"pid":null},{"fullName":"Jenny Dankelman","name":"Jenny","surname":"Dankelman","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-3951-2129"},"provenance":null}},{"fullName":"Benno H. W. Hendriks","name":"Benno H. W.","surname":"Hendriks","rank":4,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"NL","label":"Netherlands","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"tissue sensing"},"provenance":null},{"subject":{"scheme":"keyword","value":"light beam steering"},"provenance":null},{"subject":{"scheme":"keyword","value":"535"},"provenance":null},{"subject":{"scheme":"keyword","value":"Fiber optics"},"provenance":null},{"subject":{"scheme":"keyword","value":"remote light collection"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"medical devices"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"tissue illumination"},"provenance":null},{"subject":{"scheme":"keyword","value":"instrument design"},"provenance":null},{"subject":{"scheme":"keyword","value":"tissue modification"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Fiber Optic Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"remote light delivery"},"provenance":null},{"subject":{"scheme":"keyword","value":"Systematic Review"},"provenance":null}],"mainTitle":"Steering light in fiber-optic medical devices: a patent review","subTitle":null,"descriptions":["Steering light is relevant to many medical applications that require tissue illumination, sensing, or modification. To control the propagation direction of light beams, a great variety of innovative fiber-optic medical devices have been designed.This review provides a comprehensive overview of the patent literature on light beam control in fiber-optic medical devices. The Web of Science Derwent Innovation Index database was scanned, and 81 patents on fiber-optic devices published in the last 20 years (2001-2021) were retrieved and categorized based on the working principle to steer light (refraction/reflection, scattering, diffraction) and the design strategy that was employed (within fiber, at fiber end, outside fiber).Patents describing medical devices were found for all categories, except for generating diffraction at the fiber end surface. The insight in the different designs reveals that there are still several opportunities to design innovative devices that can collect light at an angle off-axis, reduce the angular distribution of light, or split light into multiple beams."],"publicationDate":"2022-03-04","publisher":"Informa UK Limited","embargoEndDate":null,"sources":["Crossref","Expert Rev Med Devices"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Expert Review of Medical Devices","issnPrinted":"1743-4440","issnOnline":"1745-2422","issnLinking":null,"ep":"271","iss":null,"sp":"259","vol":"19","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGr