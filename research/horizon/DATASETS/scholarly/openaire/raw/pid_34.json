{"header":{"numFound":1,"maxScore":1.0,"queryTime":13,"page":1,"pageSize":5},"results":[{"authors":[{"fullName":"Saccher, Marta","name":"Marta","surname":"Saccher","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9509-7815"},"provenance":null}},{"fullName":"Kawasaki, Shinnosuke","name":"Shinnosuke","surname":"Kawasaki","rank":2,"pid":null},{"fullName":"Dekker, Ronald","name":"Ronald","surname":"Dekker","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"NL","label":"Netherlands","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"capacitive micromachined ultrasound transducers"},"provenance":null},{"subject":{"scheme":"keyword","value":"zero-bias transducers"},"provenance":null},{"subject":{"scheme":"keyword","value":"ultrasound power transfer"},"provenance":null},{"subject":{"scheme":"keyword","value":"accelerated lifetime test"},"provenance":null},{"subject":{"scheme":"keyword","value":"pre-charged CMUT"},"provenance":null}],"mainTitle":"The long-term reliability of pre-charged CMUTs for the powering of deep implanted devices","subTitle":null,"descriptions":["Recently, focused ultrasound has been proposed to power deeply implanted medical devices. Almost exclusively, lead zirconate titanate (PZT) transducers are used to convert acoustic energy into electrical energy. Unfortunately, these lead containing devices cannot be hermetically encapsulated since that would block the ultrasound. We propose the use of biocompatible Capacitive Micromachined Ultrasonic Transducer (CMUT) elements to replace traditional PZT transducers. In addition, to eliminate the external bias voltage, we introduced a charge trapping Al 2 O 3  layer inside the CMUT to create a built-in bias voltage. These devices can be pre-charged and used as a receiver for US power. In this work, the viability of charged CMUTs to power deep implants was explored by investigating the effect of the charging parameters and by performing Accelerated Lifetime Tests (ALT). The estimated lifetime at body temperature ranges between 2.5 to 3.5 years at body temperature, which significantly depends on the charging parameters."],"publicationDate":"2021-09-11","publisher":"IEEE","embargoEndDate":null,"sources":["Crossref","2021 IEEE International Ultrasonics Symposium (IUS)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"2021 IEEE International Ultrasonics Symposium (IUS)","issnPrinted":null,"issnOnline":null,"issnLinking":null,"ep":"4","iss":null,"sp":"1","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::2d3fc12c0a9ba2f084b7b1f11d06e57d","originalIds":["10.1109/ius52206.2021.9593683","50|doiboost____|2d3fc12c0a9ba2f084b7b1f11d06e57d","3211373967","50|od_______571::3d6e472c600eca8eb50a062f00a5480e","oai:tudelft.nl:uuid:c5ce6b54-4fbe-4863-b64a-a87a102986af","50|r3c4b2081b22::2d3fc12c0a9ba2f084b7b1f11d06e57d","50|sygma_______::2d3fc12c0a9ba2f084b7b1f11d06e57d"],"pids":[{"scheme":"doi","value":"10.1109/ius52206.2021.9593683"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":4.0,"influence":2.4133577E-9,"popularity":3.801314E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"},"usageCounts":{"downloads":71,"views":25}},"instances":[{"pids":[{"scheme":"doi","value":"10.1109/ius52206.2021.9593683"}],"license":"https://ieeexplore.ieee.org/Xplorehelp/downloads/license-information/IEEE.html","type":"Article","urls":["https://doi.org/10.1109/ius52206.2021.9593683"],"publicationDat