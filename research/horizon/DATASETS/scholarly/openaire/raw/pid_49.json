Yewei Zhang","name":null,"surname":"Yewei Zhang","rank":15,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-1748-3849"},"provenance":null}},{"fullName":"Changhui Li","name":null,"surname":"Changhui Li","rank":16,"pid":{"id":{"scheme":"orcid","value":"0000-0002-6179-2684"},"provenance":null}},{"fullName":"Yuxin Jiang","name":null,"surname":"Yuxin Jiang","rank":17,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9797-5116"},"provenance":null}},{"fullName":"Meng Yang","name":null,"surname":"Meng Yang","rank":18,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4339-0411"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Radiology, Nuclear Medicine and Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physiology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Oxygen saturation"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biomedical Engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"Organic chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cerebral Blood Flow Measurement"},"provenance":null},{"subject":{"scheme":"keyword","value":"Tissue Optical Properties"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Medical engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"Functional Imaging"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Health Sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Ultrasound"},"provenance":null},{"subject":{"scheme":"keyword","value":"Brain Oxygenation Monitoring"},"provenance":null},{"subject":{"scheme":"keyword","value":"Photoacoustic Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physiological Responses to Heat Stress in Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biomedical Optical Imaging and Spectroscopy"},"provenance":null},{"subject":{"scheme":"keyword","value":"Photoacoustic imaging in biomedicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Optics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Advances in Photoacoustic Imaging and Tomography"},"provenance":null},{"subject":{"scheme":"keyword","value":"Materials science"},"provenance":null},{"subject":{"scheme":"keyword","value":"Oxygen"},"provenance":null},{"subject":{"scheme":"keyword","value":"Chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Biological sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical Sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nuclear medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Radiology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biomedical engineering"},"provenance":null}],"mainTitle":"Validation of photoacoustic/ultrasound dual imaging in evaluating blood oxygen saturation","subTitle":null,"descriptions":["<jats:p>                     Photoacoustic imaging (PAI) was performed to evaluate oxygen saturation (                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     ) of blood-mimicking phantoms, femoral arteries in beagles, and radial arteries in humans at various                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     plateaus. The accuracy (root mean square error, RMSE) of PAI                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     compared with reference                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     was calculated. In blood-mimicking phantoms, PAI achieved an accuracy of 1.49% and a mean absolute error (MAE) of 1.09% within 25 mm depth, and good linearity (R = 0.968; p &lt; 0.001) was obtained between PAI                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     and reference                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     . In canine femoral arteries, PAI achieved an accuracy of 2.16% and an MAE of 1.58% within 8 mm depth (R = 0.965; p &lt; 0.001). In human radial arteries, PAI achieved an accuracy of 3.97% and an MAE of 3.28% in depth from 4 to 14 mm (R = 0.892; p &lt; 0.001). For PAI                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     evaluation at different depths in healthy volunteers, the RMSE accuracy of PAI                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     increased from 2.66% to 24.96% with depth increasing from 4 to 14 mm. Through the multiscale method, we confirmed the feasibility of the hand-held photoacoustic/ultrasound (PA/US) in evaluating                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     . These results demonstrate the potential clinical value of PAI in evaluating blood                     <jats:italic>s</jats:italic>                     O                     <jats:sub>2</jats:sub>                     . Consequently, protocols for verifying the feasibility of medical devices based on PAI may be established.                   </jats:p>"],"publicationDate":"2022-09-30","publisher":"Optica Publishing Group","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Biomedical Optics Express","issnPrinted":"2156-7085","issnOnline":"2156-7085","issnLinking":null,"ep":null,"iss":null,"sp":"5551","vol":"13","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::49f8e7f47b93b6bfe50ff953c513c765","originalIds":["10.1364/boe.469747","50|doiboost____|49f8e7f47b93b6bfe50ff953c513c765","50|datacite____::9a441eb05799bcc29791586ed23bb186","10.60692/wmbmy-dd506","50|datacite____::b290a4a708f472baf72580ed7bb964dc","10.60692/p6m1n-8jq22","od_______267::3fd3e226d61fc931f68a15ec8891834c","36425613","PMC9664893"],"pids":[{"scheme":"doi","value":"10.1364/boe.469747"},{"scheme":"doi","value":"10.60692/wmbmy-dd506"},{"scheme":"doi","value":"10.60692/p6m1n-8jq22"},{"scheme":"pmid","value":"36425613"},{"scheme":"pmc","value":"PMC9664893"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":17.0,"influence":2.55974E-9,"popularity":1.19297345E-8,"impulse":16.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"instances":[{"pids":[{"scheme":"doi","value":"10.1364/boe.469747"}],"license":"CC BY","type":"Article","urls":["https://doi.org/10.1364/boe.469747"],"publicationDate":"2022-09-30","refereed":"peerReviewed"},{"pids":[{"scheme":"doi","value":"10.60692/wmbmy-dd506"}],"type":"Other literature type","urls":["https://dx.doi.org/10.60692/wmbmy-dd506"],"publicationDate":"2022-09-30","refereed":"nonPeerReviewed"},{"pids":[{"scheme":"doi","value":"10.60692/p6m1n-8jq22"}],"type":"Other literature type","urls":["https://dx.doi.org/10.60692/p6m1n-8jq22"],"publicationDate":"2022-09-30","refereed":"nonPeerReviewed"},{"pids":[{"scheme":"pmid","value":"36425613"},{"scheme":"pmc","value":"PMC9664893"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1364/boe.469747"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/36425613"],"refereed":"nonPeerReviewed"}],"isGreen":false,"isInDiamondJournal":false}]}