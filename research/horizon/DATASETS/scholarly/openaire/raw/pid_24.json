":"multicenter trials"},"provenance":null},{"subject":{"scheme":"keyword","value":"Positron Emission Tomography Computed Tomography"},"provenance":null},{"subject":{"scheme":"keyword","value":"616"},"provenance":null},{"subject":{"scheme":"keyword","value":"1103 Clinical Sciences (for)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Image Processing, Computer-Assisted"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"qualification"},"provenance":null},{"subject":{"scheme":"keyword","value":"32 Biomedical and Clinical Sciences (for-2020)"},"provenance":null},{"subject":{"scheme":"keyword","value":"3202 Clinical Sciences (for-2020)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neurosciences (rcdc)"},"provenance":null},{"subject":{"scheme":"keyword","value":"screening and diagnosis"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans (mesh)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biomedical and Clinical Sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Bioengineering (rcdc)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neurosciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Brain"},"provenance":null},{"subject":{"scheme":"keyword","value":"Positron Emission Tomography Computed Tomography (mesh)"},"provenance":null},{"subject":{"scheme":"keyword","value":"3202 Clinical sciences (for-2020)"},"provenance":null},{"subject":{"scheme":"keyword","value":"attenuation correction"},"provenance":null},{"subject":{"scheme":"keyword","value":"Computer-Assisted (mesh)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Magnetic Resonance Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nuclear Medicine & Medical Imaging (science-metrix)"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Detection"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nuclear Medicine & Medical Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"PET"},"provenance":null},{"subject":{"scheme":"keyword","value":"PET/MRI"},"provenance":null},{"subject":{"scheme":"keyword","value":"4.2 Evaluation of markers and technologies (hrcs-rac)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Positron-Emission Tomography"},"provenance":null},{"subject":{"scheme":"keyword","value":"Special Contribution"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biomedical Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"4.2 Evaluation of markers and technologies"},"provenance":null},{"subject":{"scheme":"keyword","value":"MRI"},"provenance":null}],"mainTitle":"A Path to Qualification of PET/MRI Scanners for Multicenter Brain Imaging Studies: Evaluation of MRI-Based Attenuation Correction Methods Using a Patient Phantom","subTitle":null,"descriptions":["PET/MRI scanners cannot be qualified in the manner adopted for hybrid PET/CT devices. The main hurdle with qualification in PET/MRI is that attenuation correction (AC) cannot be adequately measured in conventional PET phantoms because of the difficulty in converting the MR images of the physical structures (e.g., plastic) into electron density maps. Over the last decade, a plethora of novel MRI-based algorithms has been developed to more accurately derive the attenuation properties of the human head, including the skull. Although promising, none of these techniques has yet emerged as an optimal and universally adopted strategy for AC in PET/MRI. In this work, we propose a path for PET/MRI qualification for multicenter brain imaging studies. Specifically, our solution is to separate the head AC from the other factors that affect PET data quantification and use a patient as a phantom to assess the former. The emission data collected on the integrated PET/MRI scanner to be qualified should be reconstructed using both MRI- and CT-based AC methods, and whole-brain qualitative and quantitative (both voxelwise and regional) analyses should be performed. The MRI-based approach will be considered satisfactory if the PET quantification bias is within the acceptance criteria specified here. We have implemented this approach successfully across 2 PET/MRI scanner manufacturers at 2 sites."],"publicationDate":"2021-07-22","publisher":"Society of Nuclear Medicine","embargoEndDate":null,"sources":["Crossref","J Nucl Med","Journal of Nuclear Medicine, vol 63, iss 4"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Nuclear Medicine","issnPrinted":"0161-5505","issnOnline":"2159-662X","issnLinking":null,"ep":"621","iss":null,"sp":"615","vol":"63","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::979d41ad8acd414970c84bcfd0f56173","originalIds":["10.2967/jnumed.120.261881","50|doiboost____|979d41ad8acd414970c84bcfd0f56173","od_______267::5c05a5c0030312164a72fc67f8507f6d","34301784","PMC8973286","50|od_______267::5c05a5c0030312164a72fc67f8507f6d","oai:pubmedcentral.nih.gov:8973286","3184638900","50|od_______325::523c4204316ae41565b8e1d13a4cfe67","oai:escholarship.org:ark:/13030/qt37w1v9qh","ftcdlib:oai:escholarship.org:ark:/13030/qt37w1v9qh","50|base_oa_____::00e6b76643755278841a6f06307056f5"],"pids":[{"scheme":"doi","value":"10.2967/jnumed.120.261881"},{"scheme":"pmid","value":"34301784"},{"scheme":"pmc","value":"PMC8973286"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":9.0,"influence":2.3953806E-9,"popularity":6.