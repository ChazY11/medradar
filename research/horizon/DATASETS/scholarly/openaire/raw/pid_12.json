urname":"Kuratani","rank":13,"pid":null},{"fullName":"Jeffrey J. Popma","name":"Jeffrey J.","surname":"Popma","rank":14,"pid":null},{"fullName":"Taku Inohara","name":"Taku","surname":"Inohara","rank":15,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-7889-2083"},"provenance":null}},{"fullName":"Vinod H. Thourani","name":"Vinod H.","surname":"Thourani","rank":16,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9309-2623"},"provenance":null}},{"fullName":"John D. Carroll","name":"John D.","surname":"Carroll","rank":17,"pid":null},{"fullName":"Hideyuki Shimizu","name":"Hideyuki","surname":"Shimizu","rank":18,"pid":null},{"fullName":"Morimasa Takayama","name":"Morimasa","surname":"Takayama","rank":19,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5736-0064"},"provenance":null}},{"fullName":"Martin B. Leon","name":"Martin B.","surname":"Leon","rank":20,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-2002-7492"},"provenance":null}},{"fullName":"Michael J. Mack","name":"Michael J.","surname":"Mack","rank":21,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-3148-9158"},"provenance":null}},{"fullName":"Yoshiki Sawa","name":"Yoshiki","surname":"Sawa","rank":22,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-6132-9684"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Aged, 80 and over"},"provenance":null},{"subject":{"scheme":"keyword","value":"Surgeons"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cardiology"},"provenance":null},{"subject":{"scheme":"keyword","value":"aortic stenosis"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aortic Valve Stenosis"},"provenance":null},{"subject":{"scheme":"keyword","value":"TAVR"},"provenance":null},{"subject":{"scheme":"keyword","value":"United States"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Transcatheter Aortic Valve Replacement"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Treatment Outcome"},"provenance":null},{"subject":{"scheme":"keyword","value":"Japan"},"provenance":null},{"subject":{"scheme":"keyword","value":"bioprosthetic aortic valve"},"provenance":null},{"subject":{"scheme":"keyword","value":"Risk Factors"},"provenance":null},{"subject":{"scheme":"keyword","value":"RC666-701"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aortic Valve"},"provenance":null},{"subject":{"scheme":"keyword","value":"Diseases of the circulatory (Cardiovascular) system"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"Registries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Original Research"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aged"},"provenance":null}],"mainTitle":"Practice Patterns and Outcomes of Transcatheter Aortic Valve Replacement in the United States and Japan: A Report From Joint Data Harmonization Initiative of STS/ACC TVT and J‐TVT","subTitle":null,"descriptions":["<jats:sec xml:lang=\"en\">             <jats:title>Background</jats:title>             <jats:p xml:lang=\"en\">The practice pattern and outcome of medical devices following their regulatory approval may differ by country. The aim of this study is to compare postapproval national clinical registry data on transcatheter aortic valve replacement between the United States and Japan on patient characteristics, periprocedural outcomes, and the variability of outcomes as a part of a partnership program (Harmonization‐by‐Doing) between the 2 countries.</jats:p>           </jats:sec>           <jats:sec xml:lang=\"en\">             <jats:title>Methods and Results</jats:title>             <jats:p xml:lang=\"en\">               The patient‐level data were extracted from the US Society of Thoracic Surgeons /American College of Cardiology Transcatheter Valve Therapy (STS/ACC TVT) and the J‐TVT (Japanese Transcatheter Valvular Therapy) registry, respectively, to analyze transcatheter aortic valve replacement outcomes between 2013 and 2019. Data entry for these registries was mandated by the federal regulators, and the majority of variable definitions were harmonized to allow direct data comparison. A total of 244 722 transcatheter aortic valve replacements from 646 institutions in the United States and 26 673 transcatheter aortic valve replacements from 171 institutions in Japan were analyzed. Median volume per site was 65 (interquartile range, 45–97) in the United States and 28 (interquartile range, 19–41) in Japan. Overall, patients in J‐TVT were older (United States: mean‐age, 80.1±8.7 versus Japan: 84.4±5.2;               <jats:italic>P</jats:italic>               &lt;0.001), were more frequently women (45.9% versus 68.1%;               <jats:italic>P</jats:italic>               &lt;0.001), and had higher median Society of Thoracic Surgeons Predicted Risk of Mortality (5.27% versus 6.20%;               <jats:italic>P</jats:italic>               &lt;0.001) than patients in the United States. Japan had lower unadjusted 30‐day mortality (1.3% versus 3.2%;               <jats:italic>P</jats:italic>               &lt;0.001) and composite outcomes of death, stroke, and bleeding (17.5 versus 22.5%;               <jats:italic>P</jats:italic>               &lt;0.001) but had higher conversion to open surgery (0.94% versus 0.56%;               <jats:italic>P</jats:italic>               &lt;0.001).             </jats:p>           </jats:sec>           <jats:sec xml:lang=\"en\">             <jats:title>Conclusions</jats:title>             <jats:p xml:lang=\"en\">This collaborative analysis between the United States and Japan demonstrated the feasibility of international comparison using the national registries coded under mutual variable definitions. Both countries obtained excellent outcomes, although the Japanese had lower 30‐day mortality and major morbidity. Harmonization‐by‐Doing is one of the key steps needed to build global‐level learning to improve patient outcomes.</jats:p>           </jats:sec>"],"publicationDate":"2022-03-15","publisher":"Ovid Technologies (Wolters Kluwer Health)","embargoEndDate":null,"sources":["Crossref","J Am Heart Assoc","Journal of the American Heart Association: Cardiovascular and Cerebrovascular Disease, Vol 11, Iss 6 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of the American Heart Association","issnPrinted":null,"issnOnline":"2047-9980","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"11","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::aaaab4f6adfd8e534ff91676c3952f61","originalIds":["10.1161/JAHA.121.023848","10.1161/jaha.121.023848","50|doiboost____|aaaab4f6adfd8e534ff91676c3952f61","od_______267::fb62b397c4d56472ec175ccca745f07c","35243902","PMC9075277","oai:pubmedcentral.nih.gov:9075277","50|od_______267::fb62b397c4d56472ec175ccca745f07c","oai:doaj.org/article:44f5071606a24a2bbb656550c056e6ed","50|doajarticles::ecde8eaef1e700571b52bfbd04c4d789"],"pids":[{"scheme":"doi","value":"10.1161/jaha.121.023848"},{"scheme":"pmid","value":"35243902"},{"scheme":"pmc","value":"PMC9075277"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citation