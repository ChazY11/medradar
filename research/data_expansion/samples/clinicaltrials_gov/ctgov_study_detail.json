{"protocolSection":{"identificationModule":{"nctId":"NCT01693120","orgStudyIdInfo":{"id":"VICTORY AF"},"organization":{"fullName":"Medtronic Cardiac Ablation Solutions","class":"INDUSTRY"},"briefTitle":"Evaluation of the Phased Radio Frequency Ablation System","officialTitle":"Evaluation of Multielectrode Phased RF Technology in Persistent Atrial Fibrillation","acronym":"VICTORY-AF"},"statusModule":{"statusVerifiedDate":"2025-02","overallStatus":"TERMINATED","whyStopped":"The study was stopped solely based on lower than expected enrollment rate.","expandedAccessInfo":{"hasExpandedAccess":false},"startDateStruct":{"date":"2013-11"},"primaryCompletionDateStruct":{"date":"2017-02-07","type":"ACTUAL"},"completionDateStruct":{"date":"2017-02-07","type":"ACTUAL"},"studyFirstSubmitDate":"2012-09-19","studyFirstSubmitQcDate":"2012-09-21","studyFirstPostDateStruct":{"date":"2012-09-26","type":"ESTIMATED"},"resultsFirstSubmitDate":"2018-02-07","resultsFirstSubmitQcDate":"2018-03-21","resultsFirstPostDateStruct":{"date":"2018-03-22","type":"ACTUAL"},"lastUpdateSubmitDate":"2025-02-11","lastUpdatePostDateStruct":{"date":"2025-02-13","type":"ACTUAL"}},"sponsorCollaboratorsModule":{"responsibleParty":{"type":"SPONSOR"},"leadSponsor":{"name":"Medtronic Cardiac Ablation Solutions","class":"INDUSTRY"}},"oversightModule":{"oversightHasDmc":true},"descriptionModule":{"briefSummary":"VICTORY AF is an IDE, prospective global, multi-center, single arm, controlled, unblinded, investigational clinical study. The purpose of this clinical study is to evaluate the risk of procedure and/or device related strokes in subjects with persistent or long-standing persistent atrial fibrillation (AF) undergoing ablation with the Phased RF System."},"conditionsModule":{"conditions":["Persistent Atrial Fibrillation"],"keywords":["ablation","atrial fibrillation","Radio frequency"]},"designModule":{"studyType":"INTERVENTIONAL","phases":["NA"],"designInfo":{"allocation":"NA","interventionModel":"SINGLE_GROU