# runtime data (regenerated by `python -m medradar run`).
# The PRODUCT-001 snapshot is NOT here: it is vendored product data and lives in
# medradar/product/snapshot/ so that it ships with the package and stays out of the
# raw-data root that the licence gate keeps untracked.
data/
out/
_logs/
.playwright-mcp/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
.audit/
dist/
# PRODUCT-001: the built workbench is committed so `python -m medradar web` works without Node.
!web/dist/
!web/dist/**
.pytest_cache/
.mypy_cache/
.ruff_cache/

# office artefacts
*.xlsx
~$*

# os
.DS_Store
Thumbs.db

# NOTE: docs/ IS committed on purpose - it hosts the GitHub Pages demo site.

# cycle-2 per-row prediction dumps: regenerable intermediates, not aggregates (~7 MB)
experiments/**/pred_*.json

# SCIENCE-001: the bulk SEC response cache and the raw captured source documents
# stay local. Committed instead: the per-filing index with URLs, SHA-256 hashes,
# collection times and the derived artifacts (see research/science_001/README.md).
research/science_001/data/
research/science_001/evidence/sec_docs/raw/

# DATA-001 documentation and evidence live under docs/data, not the runtime data root.
!docs/data/
!docs/data/**
