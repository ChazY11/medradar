# runtime data (regenerated by `python -m medradar run`)
data/
out/

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
.audit/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# office artefacts
*.xlsx
~$*

# os
.DS_Store
Thumbs.db

# NOTE: docs/ IS committed on purpose - it hosts the GitHub Pages demo site.

# cycle-2 per-row prediction dumps: regenerable intermediates, not aggregates (~7 MB)
experiments/**/pred_*.json

# ATLAS runtime artefacts: the database, the MDALL stream cache and backups are
# regenerated and must never be committed. Machine reports and the bounded
# redistributable sample ARE committed on purpose (see docs/atlas/).
research/atlas/staging/
research/atlas/cache/
research/atlas/backups/

# scratch logs from local pipeline runs
/_*.log
/_*.txt


# CONVERGENCE runtime artefacts: the staging database is regenerated by
# tools/convergence/run_integration.py and must never be committed.
research/convergence/staging/
research/convergence/reports/_scratch/


# Verification snapshot copies of the staging database: derived, large, and
# regenerable by tools/convergence/verify/verify.py. Hashes are recorded instead.
research/convergence/verification/snapshots/


# Transient reports written by tests on small slices.
research/convergence/reports/integration_det_*.json
research/convergence/reports/integration_e2e_test.json

