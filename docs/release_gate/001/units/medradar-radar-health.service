# CANDIDATE - NOT INSTALLED. Release-gate artifact, see docs/release_gate/001/HEALTH_MONITORING.md.
# Install path: /etc/systemd/system/medradar-radar-health.service
[Unit]
Description=MedRadar Radar health probe (availability + pipeline + product trust)
Documentation=file:///srv/medradar/release-gate/001/HEALTH_MONITORING.md
After=medradar-radar-web.service medradar-radar-scheduler.service
Wants=medradar-radar-web.service

[Service]
Type=oneshot
User=medradar
Group=medradar
# The probe reads the ledger directly and only calls /healthz over HTTP, so it never needs the
# alpha credentials. It must NOT be given write access to anything.
Environment=HOME=/srv/medradar
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MEDRADAR_CODE_ROOT=/srv/medradar/radar/app
Environment=MEDRADAR_RADAR_DIR=/srv/medradar/data/radar
ExecStart=/srv/medradar/radar-venv/bin/python /srv/medradar/release-gate/001/health/radar_health.py \
    --radar-dir /srv/medradar/data/radar \
    --port 8791 --base-url http://127.0.0.1:8791 --healthz-url http://127.0.0.1:8791/healthz \
    --web-dir /srv/medradar/radar/app/web/dist \
    --state-file /var/lib/medradar-radar-health/last.json
# Exit 1 (UNHEALTHY) or 2 (UNKNOWN) marks the unit failed, which is visible in
# `systemctl --failed` and in journald. No notification channel is configured.
SuccessExitStatus=0 1 2
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/medradar-radar-health
StateDirectory=medradar-radar-health

[Install]
WantedBy=multi-user.target